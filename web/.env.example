# Optional: an Overpass proxy of your own, for cards with `osm_select`.
# VITE_OVERPASS_URL=

# Where the short-link store lives, for the "Short link" share option: the
# Worker in `share/`, with its `/_share` path. Unset means no store, and the
# share sheet says the short link is not available.
# VITE_SHARE_ENDPOINT=https://drawland-share.<account>.workers.dev/_share
